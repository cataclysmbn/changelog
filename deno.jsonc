{
  "tasks": {
    "dc": "deno run --allow-read --allow-write --allow-run=git,gh --allow-net --allow-env=GH_TOKEN,GITHUB_TOKEN,PATH,HOME,XDG_CONFIG_HOME scripts/dc_changelog.ts",
    "tui": "deno run --allow-read --allow-write --allow-run --allow-env --allow-net scripts/dc_tui.ts",
    // Re-render changelog.md and changelog.html from an edited changelog.txt
    "html": "deno run --allow-read --allow-write --allow-run --allow-env --allow-net scripts/mirror_images.ts",
    // Side-by-side before/after animated WebP: deno task compare -o out.webp BEFORE AFTER [BEFORE AFTER ...]
    "compare": "deno run --allow-read --allow-write --allow-run --allow-env --allow-net scripts/before_after.ts",
    // Commit post folders to the mdBook books on main: deno task pages dist/<period>...
    "pages": "deno run --allow-read --allow-write --allow-run --allow-env --allow-net scripts/pages.ts",
    // Build the Pages site (both books and the DCInside pages) into a folder: deno task site _site
    "site": "deno run --allow-read --allow-write --allow-run --allow-env --allow-net scripts/site.ts",
    // Preview the Korean book with live reload
    "serve": "mdbook serve book/ko",
    "check": "deno check scripts/dc_changelog.ts scripts/dc_tui.ts scripts/mirror_images.ts scripts/before_after.ts scripts/pages.ts scripts/site.ts src/dcinside.ts src/weeks.ts",
    "test": "deno test --allow-read --allow-write --allow-run --allow-env --allow-net",
  },
  "lint": {
    "include": ["scripts", "src", ".agents"],
  },
  "fmt": {
    "include": ["scripts", "src", ".agents", "README.md", "deno.jsonc"],
    "semiColons": false,
    "json.trailingCommas": "jsonc",
    "proseWrap": "never",
  },
  "imports": {
    "@cliffy/command": "jsr:@cliffy/command@^1.0.0-rc.8",
    "@david/dax": "jsr:@david/dax@^0.48.3",
    "@std/assert": "jsr:@std/assert@^1.0.15",
    "@std/encoding": "jsr:@std/encoding@^1",
    "@std/fs": "jsr:@std/fs@^1.0.19",
    "@std/path": "jsr:@std/path@^1.1.2",
    "image-size": "npm:image-size@^2.0.2",
    "marked": "npm:marked@^18.1.3",
    "@valibot/valibot": "jsr:@valibot/valibot@^1.1.0",
  },
}
