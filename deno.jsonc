{
  "tasks": {
    "dc": "deno run --allow-read --allow-write --allow-run=git,gh --allow-net --allow-env=GH_TOKEN,GITHUB_TOKEN,PATH,HOME,XDG_CONFIG_HOME scripts/dc_changelog.ts",
    "tui": "deno run --allow-read --allow-write --allow-run --allow-env scripts/dc_tui.ts",
    "upload": "deno run --allow-read=dist --allow-write=dist --allow-run=playwright-cli --allow-env=PATH,HOME,XDG_CACHE_HOME,XDG_CONFIG_HOME,XDG_DATA_HOME,TMPDIR scripts/dc_upload.ts",
    "check": "deno check scripts/dc_changelog.ts scripts/dc_tui.ts scripts/dc_upload.ts src/dcinside.ts src/weeks.ts",
    "test": "deno test --allow-read --allow-write --allow-run --allow-env",
  },
  "lint": {
    "include": ["scripts", "src", ".agents"],
  },
  "fmt": {
    "include": ["scripts", "src", ".agents", "README.md", "deno.jsonc"],
    "semiColons": false,
    "json.trailingCommas": "jsonc",
    "proseWrap": "never",
  },
  "imports": {
    "@cliffy/command": "jsr:@cliffy/command@^1.0.0-rc.8",
    "@david/dax": "jsr:@david/dax@^0.48.3",
    "@std/assert": "jsr:@std/assert@^1.0.15",
    "@std/fs": "jsr:@std/fs@^1.0.19",
    "@std/path": "jsr:@std/path@^1.1.2",
    "@valibot/valibot": "jsr:@valibot/valibot@^1.1.0",
  },
}
