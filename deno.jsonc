{
  "tasks": {
    "dc": "deno run --allow-read --allow-write --allow-run=git scripts/dc_changelog.ts",
    "check": "deno check scripts/dc_changelog.ts src/dcinside.ts",
    "test": "deno test --allow-read --allow-write --allow-run=git",
  },
  "lint": {
    "include": ["scripts", "src", ".agents"],
  },
  "fmt": {
    "include": ["scripts", "src", ".agents", "README.md", "deno.jsonc"],
    "semiColons": false,
    "json.trailingCommas": "jsonc",
    "proseWrap": "never",
  },
  "imports": {
    "@cliffy/command": "jsr:@cliffy/command@^1.0.0-rc.8",
    "@std/assert": "jsr:@std/assert@^1.0.15",
    "@std/fs": "jsr:@std/fs@^1.0.19",
    "@std/path": "jsr:@std/path@^1.1.2",
    "@valibot/valibot": "jsr:@valibot/valibot@^1.1.0",
  },
}
