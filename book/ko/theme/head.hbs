<script>
(() => {
  // The 404 page has no path to the root, only a <base> at the root.
  const root = new URL("{{ path_to_root }}", document.baseURI)
  const path = location.pathname.slice(root.pathname.length)
  // /ko and /ko/... are not pages; open the Korean site root and remember the choice.
  if (/^ko(\/|$)/u.test(path)) {
    try { localStorage.setItem("changelog-lang", "ko") } catch {}
    location.replace(new URL(path.slice(3).replace(/^\//u, ""), root).href)
    return
  }
  const other = new URL("en/" + path, root).href
  let pref
  try { pref = localStorage.getItem("changelog-lang") } catch {}
  // Pages serves this book's 404 page for missing English pages too, so never redirect those again.
  if (!path.startsWith("en/") && pref !== "ko" && !new URLSearchParams(location.search).has("ko") && (pref === "en" || !/^ko\b/iu.test(navigator.languages?.[0] ?? navigator.language))) location.replace(other)
  document.addEventListener("DOMContentLoaded", () => {
    const link = document.createElement("a")
    link.href = other
    link.hreflang = "en"
    link.className = "icon-button"
    link.title = link.ariaLabel = "English"
    link.innerHTML = `<span class=fa-svg><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 640 512"><!--! Font Awesome Free 6.2.0 by @fontawesome - https://fontawesome.com License - https://fontawesome.com/license/free (Icons: CC BY 4.0, Fonts: SIL OFL 1.1, Code: MIT License) Copyright 2022 Fonticons, Inc. --><path d="M0 128C0 92.7 28.7 64 64 64H256h48 16H576c35.3 0 64 28.7 64 64V384c0 35.3-28.7 64-64 64H320 304 256 64c-35.3 0-64-28.7-64-64V128zm320 0V384H576V128H320zM178.3 175.9c-3.2-7.2-10.4-11.9-18.3-11.9s-15.1 4.7-18.3 11.9l-64 144c-4.5 10.1 .1 21.9 10.2 26.4s21.9-.1 26.4-10.2l8.9-20.1h73.6l8.9 20.1c4.5 10.1 16.3 14.6 26.4 10.2s14.6-16.3 10.2-26.4l-64-144zM160 233.2L179 276H141l19-42.8zM448 164c11 0 20 9 20 20v4h44 16c11 0 20 9 20 20s-9 20-20 20h-2l-1.6 4.5c-8.9 24.4-22.4 46.6-39.6 65.4c.9 .6 1.8 1.1 2.7 1.6l18.9 11.3c9.5 5.7 12.5 18 6.9 27.4s-18 12.5-27.4 6.9l-18.9-11.3c-4.5-2.7-8.8-5.5-13.1-8.5c-10.6 7.5-21.9 14-34 19.4l-3.6 1.6c-10.1 4.5-21.9-.1-26.4-10.2s.1-21.9 10.2-26.4l3.6-1.6c6.4-2.9 12.6-6.1 18.5-9.8l-12.2-12.2c-7.8-7.8-7.8-20.5 0-28.3s20.5-7.8 28.3 0l14.6 14.6 .5 .5c12.4-13.1 22.5-28.3 29.8-45H448 376c-11 0-20-9-20-20s9-20 20-20h52v-4c0-11 9-20 20-20z"/></svg></span>`
    const pick = () => { try { localStorage.setItem("changelog-lang", link.hreflang) } catch {} }
    link.addEventListener("click", pick)
    link.addEventListener("auxclick", pick)
    document.querySelector(".left-buttons")?.append(link)
    // Show the date sections of a post newest first when the reader picked that order; the sidebar is built after this.
    const main = document.querySelector("main")
    const dates = [...(main?.querySelectorAll(":scope > h2") ?? [])]
    if (dates.length < 2) return
    let order
    try { order = localStorage.getItem("changelog-order") } catch {}
    if (order === "newest") {
      const end = [...main.querySelectorAll(":scope > hr")].at(-1) ?? null
      const sections = dates.map((date) => {
        const nodes = [date]
        for (let node = date.nextSibling; node && node !== end && node.tagName !== "H2"; node = node.nextSibling) nodes.push(node)
        return nodes
      })
      for (const nodes of sections.reverse()) for (const node of nodes) main.insertBefore(node, end)
    }
    const newest = order === "newest"
    const button = document.createElement("button")
    button.type = "button"
    button.className = "icon-button"
    button.title = button.ariaLabel = newest ? "최근 날짜부터" : "오래된 날짜부터"
    button.innerHTML = `<span class=fa-svg>${newest ? `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 576 512"><!--! Font Awesome Free 6.2.0 by @fontawesome - https://fontawesome.com License - https://fontawesome.com/license/free (Icons: CC BY 4.0, Fonts: SIL OFL 1.1, Code: MIT License) Copyright 2022 Fonticons, Inc. --><path d="M160 480c9 0 17.5-3.8 23.6-10.4l88-96c11.9-13 11.1-33.3-2-45.2s-33.3-11.1-45.2 2L192 365.7V64c0-17.7-14.3-32-32-32s-32 14.3-32 32V365.7L95.6 330.4c-11.9-13-32.2-13.9-45.2-2s-13.9 32.2-2 45.2l88 96C142.5 476.2 151 480 160 480zM352 320c0 17.7 14.3 32 32 32h16v64H384c-17.7 0-32 14.3-32 32s14.3 32 32 32h48 48c17.7 0 32-14.3 32-32s-14.3-32-32-32H464V320c0-17.7-14.3-32-32-32H384c-17.7 0-32 14.3-32 32zm93.7-171.1c-4.2 2-8.8 3.1-13.7 3.1c-17.7 0-32-14.3-32-32s14.3-32 32-32s32 14.3 32 32c0 12.8-7.5 23.8-18.3 28.9zm-40.7 54.9l-6.8 9.2c-10.5 14.2-7.5 34.2 6.7 44.8s34.2 7.5 44.8-6.7l48.8-65.8c14-18.9 21.5-41.7 21.5-65.2c0-48.6-39.4-88-88-88s-88 39.4-88 88c0 39.2 25.6 72.4 61.1 83.8z"/></svg>` : `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 576 512"><!--! Font Awesome Free 6.2.0 by @fontawesome - https://fontawesome.com License - https://fontawesome.com/license/free (Icons: CC BY 4.0, Fonts: SIL OFL 1.1, Code: MIT License) Copyright 2022 Fonticons, Inc. --><path d="M352 64c0 17.7 14.3 32 32 32h16v64H384c-17.7 0-32 14.3-32 32s14.3 32 32 32h48 48c17.7 0 32-14.3 32-32s-14.3-32-32-32H464V64c0-17.7-14.3-32-32-32H384c-17.7 0-32 14.3-32 32zM160 480c9 0 17.5-3.8 23.6-10.4l88-96c11.9-13 11.1-33.3-2-45.2s-33.3-11.1-45.2 2L192 365.7V64c0-17.7-14.3-32-32-32s-32 14.3-32 32V365.7L95.6 330.4c-11.9-13-32.2-13.9-45.2-2s-13.9 32.2-2 45.2l88 96C142.5 476.2 151 480 160 480zM445.7 364.9c-4.2 2-8.8 3.1-13.7 3.1c-17.7 0-32-14.3-32-32s14.3-32 32-32s32 14.3 32 32c0 12.8-7.5 23.8-18.3 28.9zm-40.7 54.9l-6.8 9.2c-10.5 14.2-7.5 34.2 6.7 44.8s34.2 7.5 44.8-6.7l48.8-65.8c14-18.9 21.5-41.7 21.5-65.2c0-48.6-39.4-88-88-88s-88 39.4-88 88c0 39.2 25.6 72.4 61.1 83.8z"/></svg>`}</span>`
    button.addEventListener("click", () => {
      try { localStorage.setItem("changelog-order", newest ? "oldest" : "newest") } catch {}
      location.reload()
    })
    document.querySelector(".left-buttons")?.append(button)
  })
})()
</script>
