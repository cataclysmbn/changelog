<script>
(() => {
  // The 404 page has no path to the root, only a <base> at the root.
  const root = new URL("{{ path_to_root }}", document.baseURI)
  const path = location.pathname.slice(root.pathname.length)
  const other = new URL("en/" + path, root).href
  let pref
  try { pref = localStorage.getItem("changelog-lang") } catch {}
  // Pages serves this book's 404 page for missing English pages too, so never redirect those again.
  if (!path.startsWith("en/") && pref !== "ko" && !new URLSearchParams(location.search).has("ko") && (pref === "en" || !/^ko\b/iu.test(navigator.languages?.[0] ?? navigator.language))) location.replace(other)
  document.addEventListener("DOMContentLoaded", () => {
    const link = document.createElement("a")
    link.href = other
    link.hreflang = "en"
    link.textContent = "English"
    link.className = "changelog-lang"
    const pick = () => { try { localStorage.setItem("changelog-lang", link.hreflang) } catch {} }
    link.addEventListener("click", pick)
    link.addEventListener("auxclick", pick)
    document.querySelector(".right-buttons")?.prepend(link)
    // Show the date sections of a post newest first when the reader picked that order; the sidebar is built after this.
    const main = document.querySelector("main")
    const dates = [...(main?.querySelectorAll(":scope > h2") ?? [])]
    if (dates.length < 2) return
    let order
    try { order = localStorage.getItem("changelog-order") } catch {}
    if (order === "newest") {
      const end = [...main.querySelectorAll(":scope > hr")].at(-1) ?? null
      const sections = dates.map((date) => {
        const nodes = [date]
        for (let node = date.nextSibling; node && node !== end && node.tagName !== "H2"; node = node.nextSibling) nodes.push(node)
        return nodes
      })
      for (const nodes of sections.reverse()) for (const node of nodes) main.insertBefore(node, end)
    }
    const select = document.createElement("select")
    select.className = "changelog-order"
    for (const [value, label] of [["oldest", "오래된 날짜부터"], ["newest", "최근 날짜부터"]]) select.add(new Option(label, value, false, value === (order === "newest" ? "newest" : "oldest")))
    select.addEventListener("change", () => {
      try { localStorage.setItem("changelog-order", select.value) } catch {}
      location.reload()
    })
    document.querySelector(".right-buttons")?.prepend(select)
  })
})()
</script>
<style>
.changelog-lang { margin-inline: 8px; line-height: var(--menu-bar-height); color: var(--icons); text-decoration: none; }
.changelog-order { margin-inline: 8px; border: none; background: transparent; color: var(--icons); font: inherit; }
.changelog-order option { background: var(--bg); color: var(--fg); }
</style>
